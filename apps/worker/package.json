{
  "name": "@builderdo/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1163.0",
    "@builderdo/shared": "workspace:*",
    "pino": "9.14.0",
    "zod": "4.6.7",
    "@builderdo/db": "workspace:*",
    "@sentry/node": "10.78.0",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
