# Copy to .env (cp .env.example .env). Values below match docker-compose.yml.
# Never commit real secrets. Production values come from AWS Secrets Manager.

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://builderdo:builderdo@localhost:5432/builderdo

# Queue (ElasticMQ locally, Amazon SQS in AWS)
QUEUE_ENDPOINT=http://localhost:9324
QUEUE_REGION=us-east-1
QUEUE_JOBS_URL=http://localhost:9324/000000000000/builderdo-jobs
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# File storage (S3Mock locally, Cloudflare R2 in AWS environments)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=builderdo-uploads
STORAGE_ACCESS_KEY_ID=local
STORAGE_SECRET_ACCESS_KEY=local

# Email (Mailpit locally: open http://localhost:8025 to see every email)
SMTP_HOST=localhost
SMTP_PORT=1025

# Web
API_URL=http://localhost:4000

# Optional
# SENTRY_DSN=
